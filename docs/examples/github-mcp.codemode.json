{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}",
        "X-MCP-Readonly": "true",
        "X-MCP-Tools": "pull_request_read,issue_read,actions_list,actions_get,get_job_logs"
      },
      "exposure": "codemode",
      "description": "Read-only GitHub PR, linked Issue, diff, discussion and current-commit CI log analysis."
    }
  }
}
